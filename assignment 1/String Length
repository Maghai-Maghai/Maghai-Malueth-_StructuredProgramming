#include <stdio.h>
#include <string.h>

int main()
{
    char name[100];

    printf("Enter your name (or a string): ");
    fgets(name, sizeof(name), stdin);
    name[strcspn(name, "\n")] = 0;
    printf("You entered: %s\n", name);
    int length = strlen(name);
    printf("The length of your string is: %d\n", length);

    return 0;
}
